# Dev defaults for infra/docker-compose.yml backing services.
# Reference only — docker-compose.yml hardcodes these dev defaults.
# Never commit a real .env.

# Postgres (rag-postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# MinIO (rag-minio) — console at :9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documents

# Qdrant (rag-qdrant) — gRPC on :6334
QDRANT_ENDPOINT=http://localhost:6333

# Redis (rag-redis)
REDIS_ENDPOINT=redis://localhost:6379/0

# RabbitMQ (rag-rabbitmq) — management UI at :15672
RABBITMQ_ENDPOINT=amqp://guest:guest@localhost:5672/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Langfuse (rag-langfuse) — see langfuse/docker-compose.langfuse.yml
LANGFUSE_PORT=3000

# Flagsmith (rag-flagsmith) — edge SDK API at :8001
FLAGSMITH_API_PORT=8000
FLAGSMITH_EDGE_PORT=8001

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
